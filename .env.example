# ============================================================
# MyKit Environment Variables
# ============================================================

# Database Connection
MONGODB_URI=mongodb://127.0.0.1:27017/mykit
MONGODB_DB_NAME=mykit

# Admin Authentication
ADMIN_EMAIL=admin@mykit.com
ADMIN_PASSWORD=AdminSecure@123
ADMIN_JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars

# Real-time Provider (polling fallback is built-in; options: polling, pusher, ably)
REALTIME_PROVIDER=polling
REALTIME_API_KEY=
REALTIME_CHANNEL=mykit_orders

# Public App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
